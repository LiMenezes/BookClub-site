NODE_ENV=production
DB_DRIVER=postgres
DB_SCHEMA=bookclub
DATABASE_URL=
DB_SSL=verify
DB_SSL_CA=
DB_POOL_MAX=5
APP_ORIGIN=https://SEU-SERVICO.onrender.com
TRUST_PROXY=1
REQUIRE_EMAIL=true
# Configure UM provedor de e-mail HTTPS e valide o remetente na conta dele.
MAIL_FROM=BookClub <REMETENTE-VALIDADO>
BREVO_API_KEY=
RESEND_API_KEY=
# Alternativa para hospedagens que permitem SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Opcionais, até configurar os aplicativos OAuth nas respectivas contas:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
