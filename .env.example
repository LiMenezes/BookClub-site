PORT=3000
# Modo externo: npm run start:postgres. Modo local: npm start.
DATABASE_URL=postgresql://bookclub:bookclub@localhost:5432/bookclub
APP_ORIGIN=http://localhost:3000
# Somente em produção: NODE_ENV=production e DB_DRIVER=postgres
DB_DRIVER=postgres
REQUIRE_EMAIL=false
GOOGLE_BOOKS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BookClub <nao-responda@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Configure TRUST_PROXY apenas se houver proxy confiável à frente.
# TRUST_PROXY=1
# DATA_DIR=C:/caminho-local/fora-da-sincronizacao/postgres
